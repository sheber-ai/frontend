{
	"name": "sheber-frontend",
	"version": "0.1.0",
	"scripts": {
		"dev": "vite",
		"build": "vite build && tsc -b",
		"preview": "vite preview",
		"typecheck": "tsc -b",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:fsd": "steiger ./src",
		"test": "vitest run",
		"test:watch": "vitest",
		"generate:api": "orval",
		"prepare": "husky",
		"ui:add": "node scripts/ui-add.mjs"
	},
	"type": "module",
	"private": true,
	"dependencies": {
		"@hookform/resolvers": "^5.9.1",
		"@react-three/drei": "^10.7.9",
		"@react-three/fiber": "^9.8.1",
		"@tanstack/react-query": "^5.104.1",
		"@tanstack/react-router": "^1.170.41",
		"axios": "^1.20.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cn": "^0.4.0",
		"i18next": "^26.4.2",
		"lucide-react": "^1.53.0",
		"radix-ui": "^1.7.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-hook-form": "^7.89.0",
		"react-i18next": "^17.0.16",
		"tailwind-merge": "^3.7.0",
		"three": "^0.186.1",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@feature-sliced/steiger-plugin": "^0.8.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query-devtools": "^5.104.1",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/router-plugin": "^1.168.42",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/three": "^0.186.0",
		"@vitejs/plugin-react": "^6.1.2",
		"husky": "^9.1.7",
		"jsdom": "^30.1.2",
		"lint-staged": "^17.6.0",
		"orval": "^8.40.0",
		"steiger": "^0.7.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^8.3.3",
		"vitest": "^5.0.3"
	},
	"lint-staged": {
		"*.{ts,tsx,js,mjs,json,jsonc,css}": "biome check --write --no-errors-on-unmatched"
	}
}
